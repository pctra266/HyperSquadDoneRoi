# ════════════════════════════════════════════════════════════════════
# .gitignore — HyperSquad Cat Clicker
# ════════════════════════════════════════════════════════════════════

# ── 🔐 SECRETS — NEVER commit these ─────────────────────────────────
js/env.js

# ── Node / npm ───────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# ── Build output ─────────────────────────────────────────────────────
dist/
build/
.cache/
.parcel-cache/
.vite/

# ── OS generated ─────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ── Editor / IDE ─────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.history/

# ── Environment / secrets (belt-and-suspenders) ──────────────────────
.env
.env.*
!.env.example
*.local
config.local.js

# ── Logs ─────────────────────────────────────────────────────────────
logs/
*.log

# ── Firebase emulator data ───────────────────────────────────────────
.firebase/
firebase-debug.log
firestore-debug.log
database-debug.log
ui-debug.log
